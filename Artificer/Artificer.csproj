<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Authors>alejandrofelipe (fork de Asriel Camora)</Authors>
    <Version>2.30.1.0</Version>
    <PackageProjectUrl>https://github.com/WorkingRobot/Craftimizer.git</PackageProjectUrl>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  
   <ItemGroup>
     <EmbeddedResource Include="Graphics\icon.png" />
     <EmbeddedResource Include="Graphics\horse_icon.png" />
     <EmbeddedResource Include="Graphics\collectible_badge.png" />
     <EmbeddedResource Include="Graphics\expert.png" />
     <EmbeddedResource Include="Graphics\expert_badge.png" />
     <EmbeddedResource Include="Graphics\no_manip.png" />
     <EmbeddedResource Include="Graphics\specialist.png" />
     <EmbeddedResource Include="Graphics\splendorous.png" />
   </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <!-- Security override do SQLite nativo (CVE-2025-6965 / CVE-2025-70873): força o binário
         lib.e_sqlite3 patched (SQLite 3.53.x), sobrepondo o 2.1.10 transitivo do Microsoft.Data.Sqlite.
         O pacote nativo não tem dependência gerenciada, então pareia com o core 2.x. Remover quando o
         Microsoft.Data.Sqlite empacotar SQLite 3.5x (11.x estável). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
    <PackageReference Include="Meziantou.Analyzer" Version="2.0.264">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\Artificer.Simulator\Artificer.Simulator.csproj" />
    <ProjectReference Include="..\Artificer.Solver\Artificer.Solver.csproj" />
    <ProjectReference Include="..\Artificer.UI\Artificer.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Artificer.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Dalamud provides cimgui.dll natively; shipping our own causes a second GImGui context
       (GImGui==NULL) that crashes Theme.Push(). ImGui.NET.dll is a managed-only wrapper
       that P/Invokes into cimgui.dll, so shipping it is safe — we ship it, Dalamud owns
       the native layer. Dalamud SDK 15+ no longer distributes ImGui.NET.dll at all. -->
  <Target Name="RemoveCimguiDll" AfterTargets="Build">
    <Delete Files="$(OutDir)cimgui.dll" Condition="Exists('$(OutDir)cimgui.dll')" />
  </Target>

</Project>
