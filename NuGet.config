<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only use nuget.org for vulnerability auditing.
       The Dalamud source doesn't expose a vulnerability index, causing NU1900 warnings. -->
  <auditSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
