{
  "name": "Craftimizer - FFXIV Dalamud Plugin",
  "version": "2.10.0.2",
  "description": "Plugin Dalamud para Final Fantasy XIV - Simulador de crafting, solver MCTS/Raphael, UI ImGui, hooks no jogo, integração com Lumina/FFXIVClientStructs",
  
  "preferences": {
    "model": "claude-sonnet-4.5",
    "defaultAgent": "craftimizer-dalamud",
    "temperature": 0.7,
    "maxTokens": 8192
  },
  
  "context": {
    "primaryLanguage": "C#",
    "framework": ".NET 10",
    "targetFramework": "net10.0-windows",
    "platform": "x64",
    "projectType": "Dalamud Plugin",
    "technologies": [
      "Dalamud SDK 15.0.0",
      "FFXIVClientStructs",
      "Lumina (game data sheets)",
      "ImGui (DearImGui bindings)",
      "Raphael.Net (Rust solver)",
      "Microsoft.Data.Sqlite",
      "MathNet.Numerics"
    ]
  },
  
  "structure": {
    "mainProject": "Craftimizer/",
    "simulator": "Simulator/",
    "solver": "Solver/",
    "tests": "Test/",
    "benchmarks": "Benchmark/",
    "scripts": "scripts/",
    "documentation": [
      ".github/agents/",
      ".github/instructions/",
      ".github/skills/",
      "backlog/"
    ]
  },
  
  "workflows": {
    "build": "dotnet build Craftimizer/Craftimizer.csproj -c Release",
    "deploy": ".\\scripts\\build.ps1 -Deploy",
    "test": "dotnet test Test/Craftimizer.Test.csproj",
    "versionBump": ".\\scripts\\bump-version.ps1 -Type {major|minor|patch|build}"
  },
  
  "conventions": {
    "versionFormat": "MAJOR.MINOR.PATCH.BUILD",
    "commitStyle": "Conventional Commits",
    "luminaAccess": "via LuminaSheets.GetSheet<T>() only",
    "servicePattern": "Service.Instance (DI via [PluginService])",
    "unsafeCode": "allowed in Craftimizer/ project only"
  },
  
  "agentsPath": ".claude/agents/",
  "skillsPath": ".claude/skills/",
  "instructionsPath": ".claude/instructions/",
  
  "excludePatterns": [
    "bin/",
    "obj/",
    "TestResults/",
    "backlog/",
    "design/",
    "dist/",
    ".vs/",
    "packages.lock.json"
  ]
}
